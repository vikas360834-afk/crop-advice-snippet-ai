# Copy this file to .env and fill it in. Never commit .env.
#
# One chat endpoint, three settings. Pick ONE of these blocks:
#
# 1) A model on your own laptop with Ollama (run `ollama serve`, then `ollama pull <model>`)
#    LLM_BASE_URL=http://localhost:11434/v1
#    LLM_API_KEY=
#    LLM_MODEL=qwen2.5:7b
#
# 2) A free Groq key (https://console.groq.com)
#    LLM_BASE_URL=https://api.groq.com/openai/v1
#    LLM_API_KEY=your-key-here
#    LLM_MODEL=llama-3.1-8b-instant
#
# 3) A free Gemini key (https://aistudio.google.com)
#    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#    LLM_API_KEY=your-key-here
#    LLM_MODEL=gemini-2.5-flash

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Where this project keeps its data
DATA_PATH=data/app.json
